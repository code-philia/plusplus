# Reproduction profile: gpt
# Fill in the main model's provider URL and API key before generation.
# MODEL is preconfigured; change it only if your provider uses a different ID.
OPENAI_BASE_URL=
OPENAI_API_KEY=
MODEL=gpt-5.6-sol

# Fill in a vision-capable model's provider URL, API key, and model ID.
# Both main-model and visual-model endpoints must be configured for reproduction.
VISUAL_BASE_URL=
VISUAL_API_KEY=
VISUAL_MODEL=gpt-5.6-sol

# Reproduction budgets.
MODEL_ATTEMPT=5
ARC_TDD_MAX_ITERATIONS=5
ARC_TDD_LOAD_ROUNDS=12
