# ============================================================
# ARC Configuration Example
# ============================================================
# Copy this file to .env and fill in your values.
# Configuration priority: shell env > ARC_ENV_FILE > ./.env

# ============================================================
# Required: OpenAI Chat Completions API endpoint
# ============================================================
OPENAI_API_KEY=sk-your-api-key-here
OPENAI_BASE_URL=https://api.openai.com/v1

# Required: Main coding model
# Examples: gpt-4o, gpt-4-turbo, claude-3-5-sonnet (via compatible endpoint)
MODEL=gpt-4o

# ============================================================
# Optional: Visual analysis for screenshots and UI references
# ============================================================
# Leave empty to skip visual analysis or reuse main model settings
VISUAL_API_KEY=
VISUAL_BASE_URL=
VISUAL_MODEL=

# ============================================================
# Optional: Debug and tuning
# ============================================================
# ARC_DEBUG: Enable detailed logging to workspace/.arc/debug.log
# - 0 or empty: disabled (default)
# - 1: enabled
ARC_DEBUG=0

# ARC_STRUCTURED_OUTPUT_RETRY_COUNT: Retry budget when agent output parsing fails
# Default: 2
ARC_STRUCTURED_OUTPUT_RETRY_COUNT=2

# ARC_DATABASE_TRACE: Print Stage 1 pass progress and rejected decision summaries
# Default: 1
ARC_DATABASE_TRACE=1

# ARC_MODEL_TRACE_FILES: Also write per-attempt diagnostic JSON files.
# Model request/output/retry events are always printed through ARC_DATABASE_TRACE.
# Default: 0
ARC_MODEL_TRACE_FILES=0

# ARC_DESIGN_BATCH_SIZE: Maximum requirements analyzed in one serial design call
# Default: 6
ARC_DESIGN_BATCH_SIZE=6

# ARC_DESIGN_TRACE: Print each Module Draft/Dataflow Link model call and raw JSON result to terminal and debug.log
# Default: 1
ARC_DESIGN_TRACE=1

# ============================================================
# Optional: Custom environment file path
# ============================================================
# ARC_ENV_FILE: Point to a different .env file
# Example: ARC_ENV_FILE=~/.arc/global.env
# ARC_ENV_FILE=
